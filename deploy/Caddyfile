# HTTPS certificates come from Let's Encrypt for $DOMAIN automatically.
{$DOMAIN} {
	encode zstd gzip
	handle_path /api/* {
		reverse_proxy api:3000
	}
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
