# The server's address. Point its DNS A record at this server before starting.
DOMAIN=pos.example.ly
# Long random values: openssl rand -hex 32
DB_PASSWORD=
JWT_SECRET=
# The first platform admin, created on first start only.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Online subscription payments through Plutu (plutu.ly): bank cards, Sadad, Edfali.
# Leave empty to take payments by bank transfer only. Keys come from my.plutus.ly → API Keys & Token.
PLUTU_API_KEY=
PLUTU_ACCESS_TOKEN=
PLUTU_SECRET_KEY=
# 1 while using the test-mode token
PLUTU_TEST=
# Optional: only some of localbankcards,sadad,edfali
PLUTU_METHODS=
