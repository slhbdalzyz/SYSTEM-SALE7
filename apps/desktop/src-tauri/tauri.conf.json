{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sale7 POS",
  "version": "0.3.0",
  "identifier": "ly.sale7.pos",
  "build": {
    "beforeBuildCommand": "pnpm run build:web",
    "frontendDist": "../../web/dist-demo"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "نقطة البيع", "width": 1280, "height": 800, "maximized": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": { "nsis": { "languages": ["Arabic", "English"] } }
  }
}
